# Server-side Google OAuth configuration only (not EXPO_PUBLIC_*).
# When credentials are available, copy these entries to .env at the PROJECT ROOT,
# which Supabase CLI reads. Keep the provider disabled until they are supplied.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-client-secret
